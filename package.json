{
  "name": "@shan8851/runready",
  "version": "0.1.0",
  "description": "Local dev preflight CLI that checks whether a repo is ready to run.",
  "license": "MIT",
  "author": "Shan <https://github.com/shan8851>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shan8851/runready.git"
  },
  "bugs": {
    "url": "https://github.com/shan8851/runready/issues"
  },
  "homepage": "https://github.com/shan8851/runready#readme",
  "keywords": [
    "cli",
    "developer-tools",
    "dev-environment",
    "environment",
    "env",
    "preflight",
    "repo-health",
    "agents",
    "ai-agent",
    "openclaw"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.23.0",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "bin": {
    "runready": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs/assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm run typecheck && pnpm test && pnpm run lint && pnpm build"
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/types": "^7.29.0",
    "boxen": "^8.0.1",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "execa": "^9.6.0",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "semver": "^7.7.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.19.24",
    "@types/semver": "^7.7.1",
    "eslint": "^9.39.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8"
  }
}
